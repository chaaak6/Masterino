ARG NODEJS_VERSION="24"
ARG BASE_REGISTRY="docker.io/library"
FROM ${BASE_REGISTRY}/node:${NODEJS_VERSION}-slim AS builder
ARG USE_CN_MIRROR
ENV CI=true
WORKDIR /app
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml tsconfig.json ./
COPY patches patches
COPY apps/market/package.json apps/market/package.json
RUN --mount=type=cache,id=masterino-market-npm-cache,target=/root/.npm,sharing=locked \
    set -e && \
    if [ "${USE_CN_MIRROR:-false}" = "true" ]; then \
      export SENTRYCLI_CDNURL="https://npmmirror.com/mirrors/sentry-cli"; \
      export FFMPEG_BINARIES_URL="https://npmmirror.com/mirrors/ffmpeg-static"; \
      npm config set registry "https://registry.npmmirror.com/"; \
    fi && \
    export COREPACK_NPM_REGISTRY="$(npm config get registry | sed 's/\/$//')" && \
    export PNPM_SPEC="$(node -p 'require("./package.json").packageManager.split("+")[0]')" && \
    corepack enable && \
    corepack prepare "$PNPM_SPEC" --activate && \
    if [ "${USE_CN_MIRROR:-false}" = "true" ]; then \
      pnpm config set registry "https://registry.npmmirror.com/"; \
    fi && \
    for attempt in 1 2 3; do \
      if pnpm install --frozen-lockfile --ignore-scripts --filter @masterino/market... --prefer-offline --prod=false; then break; fi; \
      if [ "$attempt" -eq 3 ]; then exit 1; fi; \
      sleep "$((attempt * 5))"; \
    done
COPY apps/market apps/market
RUN pnpm --filter @masterino/market build && \
    mkdir -p apps/market/dist/migrations && \
    cp apps/market/src/migrations/*.sql apps/market/dist/migrations/ && \
    pnpm --config.inject-workspace-packages=true --filter @masterino/market --prod deploy /out

FROM ${BASE_REGISTRY}/node:${NODEJS_VERSION}-slim AS runtime
ENV NODE_ENV=production
WORKDIR /app
COPY --from=builder /out ./
USER node
EXPOSE 3220 3221
CMD ["node", "dist/index.js"]
